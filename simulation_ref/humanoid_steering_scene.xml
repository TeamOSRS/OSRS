<mujoco model="custom_humanoid_steering">
  <compiler angle="radian" autolimits="true"/>

  <asset>
    <!-- Visual Materials -->
    <material name="white_plastic" rgba="0.92 0.92 0.92 1" shininess="0.3" specular="0.2"/>
    <material name="metal_silver" rgba="0.75 0.75 0.78 1" shininess="0.8" specular="0.7"/>
    <material name="motor_black" rgba="0.18 0.18 0.18 1" shininess="0.4" specular="0.3"/>
    <material name="acrylic_glass" rgba="0.85 0.92 1.0 0.35" shininess="0.9" specular="0.9"/>
    <material name="wheel_rubber" rgba="0.08 0.08 0.08 1" shininess="0.1" specular="0.1"/>
    <material name="face_screen" rgba="0.1 0.1 0.15 1" shininess="0.9" specular="0.9"/>
  </asset>

  <default>
    <!-- Actuator and Joint defaults for Dynamixel XM430/XH430 type servos -->
    <joint damping="1.5" armature="0.06" frictionloss="0.05"/>
    <position kp="45.0" forcerange="-10 10"/>
    
    <!-- Hierarchical Defaults to avoid duplicate classes -->
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2"/>
      <default class="stand_part">
        <geom material="metal_silver"/>
      </default>
      <default class="white_shell_visual">
        <geom material="white_plastic"/>
      </default>
      <default class="motor_block">
        <geom material="motor_black" type="cylinder"/>
      </default>
    </default>
    
    <default class="collision">
      <geom group="3" condim="3" friction="1.0 0.005 0.0001"/>
      <default class="white_shell_collision">
        <geom material="white_plastic"/>
      </default>
    </default>
  </default>

  <worldbody>
    <!-- Base Mobile Stand (Fixed to world for stability, wheel spin is cosmetic/passive) -->
    <body name="stand_base" pos="0 0 0.05">
      <!-- Acrylic Bottom Plate -->
      <geom name="base_plate" type="box" size="0.2 0.2 0.01" material="acrylic_glass" class="collision"/>
      <geom type="box" size="0.2 0.2 0.01" material="acrylic_glass" class="visual"/>

      <!-- Cosmetic Caster Wheels -->
      <body name="wheel_fl" pos="0.17 0.17 -0.025">
        <geom type="cylinder" size="0.025 0.01" quat="0.7071 0.7071 0 0" material="wheel_rubber" class="visual"/>
      </body>
      <body name="wheel_fr" pos="0.17 -0.17 -0.025">
        <geom type="cylinder" size="0.025 0.01" quat="0.7071 0.7071 0 0" material="wheel_rubber" class="visual"/>
      </body>
      <body name="wheel_bl" pos="-0.17 0.17 -0.025">
        <geom type="cylinder" size="0.025 0.01" quat="0.7071 0.7071 0 0" material="wheel_rubber" class="visual"/>
      </body>
      <body name="wheel_br" pos="-0.17 -0.17 -0.025">
        <geom type="cylinder" size="0.025 0.01" quat="0.7071 0.7071 0 0" material="wheel_rubber" class="visual"/>
      </body>

      <!-- Aluminum Profile Extrusions (Vertical Frame) -->
      <geom class="stand_part" type="box" size="0.015 0.015 0.35" pos="0.15 0.15 0.35"/>
      <geom class="stand_part" type="box" size="0.015 0.015 0.35" pos="0.15 -0.15 0.35"/>
      <geom class="stand_part" type="box" size="0.015 0.015 0.35" pos="-0.15 0.15 0.35"/>
      <geom class="stand_part" type="box" size="0.015 0.015 0.35" pos="-0.15 -0.15 0.35"/>

      <!-- Acrylic Top Plate -->
      <geom type="box" size="0.2 0.2 0.01" pos="0 0 0.7" material="acrylic_glass" class="collision"/>
      <geom type="box" size="0.2 0.2 0.01" pos="0 0 0.7" material="acrylic_glass" class="visual"/>

      <!-- ==================== ROBOT BODY START ==================== -->
      <body name="torso" pos="0 0 0.71">
        <!-- Lower Trapezoidal Torso Section -->
        <geom class="white_shell_collision" type="box" size="0.07 0.08 0.1" pos="0 0 0.1"/>
        <geom class="white_shell_visual" type="box" size="0.07 0.08 0.1" pos="0 0 0.1"/>
        
        <!-- Upper Chest Section -->
        <geom class="white_shell_collision" type="box" size="0.09 0.15 0.12" pos="0 0 0.32"/>
        <geom class="white_shell_visual" type="box" size="0.09 0.15 0.12" pos="0 0 0.32"/>
        <!-- Chest Front Cover plate detail -->
        <geom class="white_shell_visual" type="box" size="0.005 0.14 0.11" pos="0.092 0 0.32"/>

        <!-- ==================== HEAD (2 DOF) ==================== -->
        <body name="head_yaw_link" pos="0 0 0.44">
          <joint name="head_yaw" type="hinge" axis="0 0 1" range="-1.57 1.57"/>
          <geom class="motor_block" size="0.025 0.02" pos="0 0 0.02"/>
          
          <body name="head_tilt_link" pos="0 0 0.04">
            <joint name="head_tilt" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <geom class="motor_block" size="0.025 0.02" quat="0.7071 0 0.7071 0" pos="0 0 0"/>
            
            <!-- Oval Head Shell -->
            <geom class="white_shell_collision" type="ellipsoid" size="0.06 0.08 0.1" pos="0 0 0.1"/>
            <geom class="white_shell_visual" type="ellipsoid" size="0.06 0.08 0.1" pos="0 0 0.1"/>
            
            <!-- RealSense-Style Depth Camera Assembly -->
            <geom type="box" size="0.005 0.015 0.008" pos="0.055 0 0.1" material="motor_black" class="visual"/>
            <geom type="box" size="0.012 0.045 0.012" pos="0.07 0 0.1" material="metal_silver" class="visual"/>
            <geom type="box" size="0.011 0.044 0.011" pos="0.071 0 0.1" material="motor_black" class="visual"/>
            <geom type="cylinder" size="0.006 0.002" pos="0.082 0.015 0.1" quat="0.7071 0 0.7071 0" material="face_screen" class="visual"/>
            <geom type="cylinder" size="0.006 0.002" pos="0.082 -0.015 0.1" quat="0.7071 0 0.7071 0" material="face_screen" class="visual"/>
            <geom type="cylinder" size="0.003 0.002" pos="0.082 0 0.1" quat="0.7071 0 0.7071 0" material="face_screen" class="visual"/>
            
            <camera name="head_camera" pos="0.082 0 0.1" xyaxes="0 -1 0 0 0 1" fovy="60"/>
          </body>
        </body>

        <!-- ==================== LEFT ARM (7 DOF + Gripper) ==================== -->
        <!-- Shoulder Pitch (J1) -->
        <body name="l_sho_pitch_link" pos="0 0.17 0.38">
          <joint name="l_sho_pitch" type="hinge" axis="0 1 0" range="-2.5 2.5"/>
          <geom class="motor_block" size="0.035 0.025" quat="0.7071 0 0.7071 0" pos="0 0 0"/>
          
          <!-- Shoulder Roll (J2) -->
          <body name="l_sho_roll_link" pos="0 0.04 0">
            <joint name="l_sho_roll" type="hinge" axis="1 0 0" range="-0.2 2.0"/>
            <geom class="motor_block" size="0.035 0.025" quat="0.7071 0.7071 0 0" pos="0 0 0"/>
            
            <!-- Shoulder Yaw (J3) -->
            <body name="l_sho_yaw_link" pos="0 0.04 -0.05">
              <joint name="l_sho_yaw" type="hinge" axis="0 0 1" range="-1.57 1.57"/>
              <geom class="motor_block" size="0.03 0.02" pos="0 0 0"/>
              
              <!-- Upper Arm Link -->
              <geom class="white_shell_collision" type="box" size="0.035 0.032 0.08" pos="0 0 -0.1"/>
              <geom class="white_shell_visual" type="box" size="0.035 0.032 0.08" pos="0 0 -0.1"/>
              
              <!-- Elbow Pitch (J4) -->
              <body name="l_el_pitch_link" pos="0 0 -0.18">
                <joint name="l_el_pitch" type="hinge" axis="0 1 0" range="-2.4 0.1"/>
                <geom class="motor_block" size="0.03 0.022" quat="0.7071 0 0.7071 0" pos="0 0 0"/>
                
                <!-- Forearm Yaw (J5) -->
                <body name="l_forearm_yaw_link" pos="0 0 -0.04">
                  <joint name="l_forearm_yaw" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
                  <geom class="motor_block" size="0.026 0.02" pos="0 0 0"/>
                  
                  <!-- Forearm Link -->
                  <geom class="white_shell_collision" type="box" size="0.03 0.028 0.06" pos="0 0 -0.08"/>
                  <geom class="white_shell_visual" type="box" size="0.03 0.028 0.06" pos="0 0 -0.08"/>
                  
                  <!-- Wrist Pitch (J6) -->
                  <body name="l_wrist_pitch_link" pos="0 0 -0.14">
                    <joint name="l_wrist_pitch" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
                    <geom class="motor_block" size="0.024 0.018" quat="0.7071 0 0.7071 0" pos="0 0 0"/>
                    
                    <!-- Wrist Yaw (J7) -->
                    <body name="l_wrist_yaw_link" pos="0 0 -0.035">
                      <joint name="l_wrist_yaw" type="hinge" axis="1 0 0" range="-1.57 1.57"/>
                      <geom class="motor_block" size="0.022 0.016" pos="0 0 0"/>
                      
                      <!-- Gripper Base Box -->
                      <geom class="white_shell_collision" type="box" size="0.02 0.02 0.015" pos="0 0 -0.015"/>
                      <geom class="white_shell_visual" type="box" size="0.02 0.02 0.015" pos="0 0 -0.015"/>
                      
                      <!-- End-effector tracking site -->
                      <site name="l_eef" pos="0 0 -0.05" size="0.01" rgba="0 1 0 1"/>
                      
                      <!-- Parallel Gripper (Slide fingers in local Y-axis) -->
                      <body name="l_gripper_l_finger" pos="-0.02 0.025 -0.04">
                        <joint name="l_finger_l_joint" type="slide" axis="0 -1 0" range="0 0.02"/>
                        <geom class="white_shell_collision" type="box" size="0.018 0.005 0.01" pos="0 0 -0.01"/>
                        <geom class="white_shell_visual" type="box" size="0.018 0.005 0.01" pos="0 0 -0.01"/>
                      </body>
                      <body name="l_gripper_r_finger" pos="-0.02 -0.025 -0.04">
                        <joint name="l_finger_r_joint" type="slide" axis="0 1 0" range="0 0.02"/>
                        <geom class="white_shell_collision" type="box" size="0.018 0.005 0.01" pos="0 0 -0.01"/>
                        <geom class="white_shell_visual" type="box" size="0.018 0.005 0.01" pos="0 0 -0.01"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>

        <!-- ==================== RIGHT ARM (7 DOF + Gripper) ==================== -->
        <!-- Shoulder Pitch (J1) -->
        <body name="r_sho_pitch_link" pos="0 -0.17 0.38">
          <joint name="r_sho_pitch" type="hinge" axis="0 -1 0" range="-2.5 2.5"/>
          <geom class="motor_block" size="0.035 0.025" quat="0.7071 0 0.7071 0" pos="0 0 0"/>
          
          <!-- Shoulder Roll (J2) -->
          <body name="r_sho_roll_link" pos="0 -0.04 0">
            <joint name="r_sho_roll" type="hinge" axis="-1 0 0" range="-2.0 0.2"/>
            <geom class="motor_block" size="0.035 0.025" quat="0.7071 -0.7071 0 0" pos="0 0 0"/>
            
            <!-- Shoulder Yaw (J3) -->
            <body name="r_sho_yaw_link" pos="0 -0.04 -0.05">
              <joint name="r_sho_yaw" type="hinge" axis="0 0 -1" range="-1.57 1.57"/>
              <geom class="motor_block" size="0.03 0.02" pos="0 0 0"/>
              
              <!-- Upper Arm Link -->
              <geom class="white_shell_collision" type="box" size="0.035 0.032 0.08" pos="0 0 -0.1"/>
              <geom class="white_shell_visual" type="box" size="0.035 0.032 0.08" pos="0 0 -0.1"/>
              
              <!-- Elbow Pitch (J4) -->
              <body name="r_el_pitch_link" pos="0 0 -0.18">
                <joint name="r_el_pitch" type="hinge" axis="0 -1 0" range="-0.1 2.4"/>
                <geom class="motor_block" size="0.03 0.022" quat="0.7071 0 0.7071 0" pos="0 0 0"/>
                
                <!-- Forearm Yaw (J5) -->
                <body name="r_forearm_yaw_link" pos="0 0 -0.04">
                  <joint name="r_forearm_yaw" type="hinge" axis="0 0 -1" range="-2.8 2.8"/>
                  <geom class="motor_block" size="0.026 0.02" pos="0 0 0"/>
                  
                  <!-- Forearm Link -->
                  <geom class="white_shell_collision" type="box" size="0.03 0.028 0.06" pos="0 0 -0.08"/>
                  <geom class="white_shell_visual" type="box" size="0.03 0.028 0.06" pos="0 0 -0.08"/>
                  
                  <!-- Wrist Pitch (J6) -->
                  <body name="r_wrist_pitch_link" pos="0 0 -0.14">
                    <joint name="r_wrist_pitch" type="hinge" axis="0 -1 0" range="-1.57 1.57"/>
                    <geom class="motor_block" size="0.024 0.018" quat="0.7071 0 0.7071 0" pos="0 0 0"/>
                    
                    <!-- Wrist Yaw (J7) -->
                    <body name="r_wrist_yaw_link" pos="0 0 -0.035">
                      <joint name="r_wrist_yaw" type="hinge" axis="-1 0 0" range="-1.57 1.57"/>
                      <geom class="motor_block" size="0.022 0.016" pos="0 0 0"/>
                      
                      <!-- Gripper Base Box -->
                      <geom class="white_shell_collision" type="box" size="0.02 0.02 0.015" pos="0 0 -0.015"/>
                      <geom class="white_shell_visual" type="box" size="0.02 0.02 0.015" pos="0 0 -0.015"/>
                      
                      <!-- End-effector tracking site -->
                      <site name="r_eef" pos="0 0 -0.05" size="0.01" rgba="1 0 0 1"/>
                      
                      <!-- Parallel Gripper (Slide fingers in local Y-axis) -->
                      <body name="r_gripper_l_finger" pos="-0.02 0.025 -0.04">
                        <joint name="r_finger_l_joint" type="slide" axis="0 -1 0" range="0 0.02"/>
                        <geom class="white_shell_collision" type="box" size="0.018 0.005 0.01" pos="0 0 -0.01"/>
                        <geom class="white_shell_visual" type="box" size="0.018 0.005 0.01" pos="0 0 -0.01"/>
                      </body>
                      <body name="r_gripper_r_finger" pos="-0.02 -0.025 -0.04">
                        <joint name="r_finger_r_joint" type="slide" axis="0 1 0" range="0 0.02"/>
                        <geom class="white_shell_collision" type="box" size="0.018 0.005 0.01" pos="0 0 -0.01"/>
                        <geom class="white_shell_visual" type="box" size="0.018 0.005 0.01" pos="0 0 -0.01"/>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Actuators (Position/Torque Control) -->
  <actuator>
    <!-- Head (2 DOF) -->
    <position name="head_yaw_act" joint="head_yaw" ctrlrange="-1.57 1.57"/>
    <position name="head_tilt_act" joint="head_tilt" ctrlrange="-0.8 0.8"/>

    <!-- Left Arm (7 DOF - Torque Motors) -->
    <motor name="l_sho_pitch_act" joint="l_sho_pitch" ctrlrange="-25 25"/>
    <motor name="l_sho_roll_act" joint="l_sho_roll" ctrlrange="-25 25"/>
    <motor name="l_sho_yaw_act" joint="l_sho_yaw" ctrlrange="-25 25"/>
    <motor name="l_el_pitch_act" joint="l_el_pitch" ctrlrange="-25 25"/>
    <motor name="l_forearm_yaw_act" joint="l_forearm_yaw" ctrlrange="-25 25"/>
    <motor name="l_wrist_pitch_act" joint="l_wrist_pitch" ctrlrange="-25 25"/>
    <motor name="l_wrist_yaw_act" joint="l_wrist_yaw" ctrlrange="-25 25"/>
    <!-- Left Gripper (Slide joint, range 0 to 0.02m) -->
    <position name="l_gripper_l_act" joint="l_finger_l_joint" ctrlrange="0 0.02" kp="200.0" forcerange="-10 10"/>
    <position name="l_gripper_r_act" joint="l_finger_r_joint" ctrlrange="0 0.02" kp="200.0" forcerange="-10 10"/>

    <!-- Right Arm (7 DOF - Torque Motors) -->
    <motor name="r_sho_pitch_act" joint="r_sho_pitch" ctrlrange="-25 25"/>
    <motor name="r_sho_roll_act" joint="r_sho_roll" ctrlrange="-25 25"/>
    <motor name="r_sho_yaw_act" joint="r_sho_yaw" ctrlrange="-25 25"/>
    <motor name="r_el_pitch_act" joint="r_el_pitch" ctrlrange="-25 25"/>
    <motor name="r_forearm_yaw_act" joint="r_forearm_yaw" ctrlrange="-25 25"/>
    <motor name="r_wrist_pitch_act" joint="r_wrist_pitch" ctrlrange="-25 25"/>
    <motor name="r_wrist_yaw_act" joint="r_wrist_yaw" ctrlrange="-25 25"/>
    <!-- Right Gripper (Slide joint, range 0 to 0.02m) -->
    <position name="r_gripper_l_act" joint="r_finger_l_joint" ctrlrange="0 0.02" kp="200.0" forcerange="-10 10"/>
    <position name="r_gripper_r_act" joint="r_finger_r_joint" ctrlrange="0 0.02" kp="200.0" forcerange="-10 10"/>
  </actuator>
</mujoco>
