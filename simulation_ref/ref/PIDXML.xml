<mujoco model="ball_balance_2d">

    <!-- ================================= -->
    <!-- Compiler -->
    <!-- ================================= -->

    <compiler angle="degree"/>

    <!-- ================================= -->
    <!-- Simulation -->
    <!-- ================================= -->

    <!-- Slower + more stable -->
    <option timestep="0.0005"
            gravity="0 0 -9.81"
            integrator="RK4"
            iterations="400"
            noslip_iterations="30"/>

    <!-- ================================= -->
    <!-- Visual -->
    <!-- ================================= -->

    <visual>

        <global offwidth="1920"
                offheight="1080"/>

        <rgba haze="0.6 0.8 1 1"/>

        <map fogstart="10"
             fogend="40"/>

        <quality shadowsize="4096"/>

        <headlight ambient="0.5 0.5 0.5"
                   diffuse="0.9 0.9 0.9"
                   specular="0.15 0.15 0.15"/>

    </visual>

    <!-- ================================= -->
    <!-- Defaults -->
    <!-- ================================= -->

    <default>

        <joint damping="0.05"/>

        <geom condim="6"
              friction="1.2 0.01 0.002"
              solref="0.02 1"
              solimp="0.995 0.999 0.0001"
              margin="0.0005"/>

    </default>

    <!-- ================================= -->
    <!-- Assets -->
    <!-- ================================= -->

    <asset>

        <!-- Sky -->
        <texture type="skybox"
                 builtin="gradient"
                 rgb1="0.55 0.75 1"
                 rgb2="0.05 0.15 0.35"
                 width="800"
                 height="800"/>

        <!-- Ground -->
        <texture name="grid"
                 type="2d"
                 builtin="checker"
                 width="512"
                 height="512"
                 rgb1="0.15 0.28 0.42"
                 rgb2="0.22 0.38 0.55"/>

        <material name="grid_mat"
                  texture="grid"
                  texrepeat="80 80"
                  reflectance="0.05"/>

        <!-- Plate -->
        <material name="plate_mat"
                  rgba="0.20 0.20 0.20 1"/>

        <!-- Ball -->
        <material name="ball_mat"
                  rgba="1 0.4 0.1 1"/>

    </asset>

    <!-- ================================= -->
    <!-- World -->
    <!-- ================================= -->

    <worldbody>

        <!-- Infinite floor -->
        <geom type="plane"
              size="100 100 1"
              pos="0 0 -0.1"
              material="grid_mat"/>

        <!-- Light -->
        <light directional="true"
               diffuse="1 1 1"
               specular="0.2 0.2 0.2"
               pos="0 -5 5"
               dir="0 1 -1"/>

        <!-- Fixed side camera -->
        <camera name="side"
                mode="fixed"
                pos="0 -1.5 0.20"
                xyaxes="1 0 0 0 0 1"/>

        <!-- ================================= -->
        <!-- Plate -->
        <!-- ================================= -->

        <body name="plate_body"
              pos="0 0 0">

            <joint name="plate_hinge"
                   type="hinge"
                   axis="0 1 0"
                   limited="true"
                   range="-15 15"
                   damping="0.25"/>

            <geom name="plate"
                  type="box"
                  size="0.20 0.10 0.0025"

                  mass="1.2"

                  friction="1.5 0.01 0.002"

                  solref="0.02 1"
                  solimp="0.995 0.999 0.0001"

                  material="plate_mat"/>

        </body>

        <!-- ================================= -->
        <!-- Ball -->
        <!-- ================================= -->

        <body name="ball"
              pos="0.08 0 0.025">

            <freejoint/>

            <geom name="ball_geom"
                  type="sphere"
                  size="0.02"

                  mass="0.005"

                  friction="1.8 0.01 0.002"

                  solref="0.02 1"
                  solimp="0.995 0.999 0.0001"

                  priority="1"

                  material="ball_mat"/>

        </body>

    </worldbody>

    <!-- ================================= -->
    <!-- PID Actuator -->
    <!-- ================================= -->

    <actuator>

        <!-- MUCH smoother -->
        <position name="tilt_control"
                  joint="plate_hinge"
                  kp="4"
                  ctrlrange="-0.12 0.12"/>

    </actuator>

    <!-- ================================= -->
    <!-- Sensors -->
    <!-- ================================= -->

    <sensor>

        <framepos objtype="body"
                  objname="ball"/>

        <framelinvel objtype="body"
                     objname="ball"/>

        <jointpos joint="plate_hinge"/>

    </sensor>

</mujoco>