<mujoco model="dual_open_manipulator_x scene">
  <include file="dual_open_manipulator_x.xml"/>

  <statistic center="0 0 0.25" extent="0.8"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.05 0.1" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.15 0.2 0.25" rgb2="0.08 0.1 0.12"
      markrgb="0.4 0.4 0.4" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true" castshadow="true"/>
    <light pos="1 1 2" dir="-1 -1 -1" directional="false" castshadow="true" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Camera 1: Top tilted camera (known pose) -->
    <camera name="top_cam" pos="0.0 -0.6 0.8" xyaxes="1 0 0 0 0.6 0.8" fovy="45"/>
    
    <!-- Camera 2: Front camera (unknown pose to be calibrated) -->
    <camera name="front_cam" pos="0.15 -0.75 0.3" xyaxes="0.98 0.2 0 -0.08 0.39 0.92" fovy="45"/>
  </worldbody>
</mujoco>
