<mujoco model="custom_humanoid_scene">
  <include file="my_bot.xml"/>

  <statistic center="0 0 0.8" extent="1.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-30"/>
  </visual>

  <asset>
    <!-- Floor Texture & Skybox -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.1 0.15" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <!-- Soft environment lights -->
    <light pos="1.5 -1.0 3.0" dir="-1.5 1.0 -3.0" directional="true" castshadow="true"/>
    <light pos="-1.5 1.0 3.0" dir="1.5 -1.0 -3.0" directional="true" castshadow="false" diffuse="0.3 0.3 0.3"/>
    
    <!-- Floor Plane -->
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" class="collision"/>

    <!-- Mocap Targets for Left and Right Grippers -->
    <body name="l_target" mocap="true" pos="0.15 0.22 0.75">
      <geom type="sphere" size="0.025" rgba="0 1 0 0.5" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.003 0.02" pos="0.02 0 0" quat="0.7071 0 0.7071 0" rgba="1 0 0 0.8" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.003 0.02" pos="0 0.02 0" quat="0.7071 0.7071 0 0" rgba="0 1 0 0.8" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.003 0.02" pos="0 0 0.02" rgba="0 0 1 0.8" contype="0" conaffinity="0"/>
    </body>

    <body name="r_target" mocap="true" pos="0.15 -0.22 0.75">
      <geom type="sphere" size="0.025" rgba="1 0 0 0.5" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.003 0.02" pos="0.02 0 0" quat="0.7071 0 0.7071 0" rgba="1 0 0 0.8" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.003 0.02" pos="0 0.02 0" quat="0.7071 0.7071 0 0" rgba="0 1 0 0.8" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.003 0.02" pos="0 0 0.02" rgba="0 0 1 0.8" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
