                      <geom type="box" size="0.004 0.011 0.020" pos="0.005 0.0 0.0" friction="1.8 1.8 1.0" solimp="0.98 0.99 0.001" solref="0.004 1" priority="1" condim="4" contype="1" conaffinity="1" group="3"/>
                    </body>
                  </body>
                  <body name="right_inner_knuckle" pos="0.0127005 0 -0.0693074" quat="0 -1 0 -3.67321e-06">
                    <inertial pos="0.0168606 3.93808e-10 0.02267" quat="0.949317 0 -0.314322 0" mass="0.0110931" diaginertia="5.59353e-06 3.96549e-06 1.88108e-06"/>
                    <joint name="right_inner_knuckle_joint" pos="0 0 0" axis="0 1 0" range="-0.8757 0.8757" actuatorfrcrange="-1000 1000" damping="2.0" armature="0.005"/>
                    <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="heal_inner_knuckle" group="2" contype="0" conaffinity="0"/>
                    <body name="right_inner_finger" pos="0.034106 0 0.0458574">
                      <inertial pos="0.00602756 0 0.00669926" quat="0.699065 0.106339 0.106339 0.699065" mass="0.00724255" diaginertia="1.70064e-06 1.58577e-06 3.69621e-07"/>
                      <joint name="right_inner_finger_joint" pos="0 0 0" axis="0 1 0" range="-0.8757 0.8757" actuatorfrcrange="-1000 1000" damping="2.0" armature="0.005"/>
                      <geom type="mesh" rgba="0.1 0.1 0.1 1" mesh="heal_inner_finger" group="2" contype="0" conaffinity="0"/>
                      <!-- High-friction collision pad box for HEAL gripper right side -->
                      <geom type="box" size="0.004 0.011 0.020" pos="-0.005 0.0 0.0" friction="1.8 1.8 1.0" solimp="0.98 0.99 0.001" solref="0.004 1" priority="1" condim="4" contype="1" conaffinity="1" group="3"/>
                    </body>
                  </body>
                  <body name="right_outer_knuckle" pos="0.0306016 0 -0.0627918" quat="0 -1 0 -3.67321e-06">
                    <inertial pos="0.0298253 7.22554e-12 0.0176992" quat="0.704408 0.0617233 0.0617233 0.704408" mass="0.0341578" diaginertia="1.15619e-05 1.10122e-05 4.54668e-06"/>
