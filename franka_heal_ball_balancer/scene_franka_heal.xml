    </body>

    <!-- ====== Balancing Task Objects ====== -->
    <!-- Plate: 40cm x 40cm, Y-axis connects the two arms                  -->
    <!-- Franka grips +Y edge at (0.20, -0.20, 0.55)                       -->
    <!-- HEAL   grips -Y edge at (0.20, -0.60, 0.55)                       -->
    <body name="plate" pos="0.20 -0.40 0.55">
      <freejoint/>
      <inertial mass="0.3" pos="0 0 0" diaginertia="0.004 0.004 0.001"/>
      <!-- 40cm x 40cm x 6mm plate -->
      <geom name="plate_geom" type="box" size="0.20 0.20 0.003"
            material="plate_mat"
            friction="0.8 0.005 0.0001"
            contype="1" conaffinity="1"/>
      <!-- Sites: +Y edge (Franka side), -Y edge (HEAL side), centre -->
      <site name="plate_franka_edge" pos="0  0.20 0.003" size="0.012" rgba="0.9 0.3 0.3 1"/>
      <site name="plate_heal_edge"   pos="0 -0.20 0.003" size="0.012" rgba="0.3 0.9 0.3 1"/>
      <site name="plate_center"      pos="0  0    0.003" size="0.012" rgba="1.0 1.0 0.2 1"/>
    </body>

    <!-- Ball: starts centred on plate -->
    <body name="ball" pos="0.20 -0.40 0.578">
      <freejoint/>
      <inertial mass="0.1" pos="0 0 0" diaginertia="8e-5 8e-5 8e-5"/>
      <geom name="ball_geom" type="sphere" size="0.025"
            material="ball_mat"
            friction="0.4 0.005 0.0001"
            contype="1" conaffinity="1"/>
      <site name="ball_site" pos="0 0 0" size="0.008" rgba="1 1 0 1"/>
    </body>

  </worldbody>

  <tendon>
    <fixed name="split">
      <joint joint="finger_joint1" coef="0.5"/>
      <joint joint="finger_joint2" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="finger_joint1" joint2="finger_joint2" solimp="0.5 0.9 0.01" solref="0.02 1"/>
    <!-- Robotiq 85 mimic constraints -->
    <joint joint1="left_inner_knuckle_joint" joint2="finger_joint" polycoef="0 1.2 0 0 0"/>
    <joint joint1="left_inner_finger_joint" joint2="finger_joint" polycoef="0 -1.2 0 0 0"/>
    <joint joint1="right_outer_knuckle_joint" joint2="finger_joint" polycoef="0 -1 0 0 0"/>
    <joint joint1="right_inner_knuckle_joint" joint2="finger_joint" polycoef="0 -1.2 0 0 0"/>
    <joint joint1="right_inner_finger_joint" joint2="finger_joint" polycoef="0 1.2 0 0 0"/>

    <!-- Welds to keep the grasp perfectly rigid throughout the simulation -->
    <weld body1="plate" body2="hand" relpose="0 0.29 0  0.70710678 0.70710678 0 0" solimp="0.5 0.9 0.01" solref="0.02 1"/>
    <weld body1="plate" body2="end-effector" relpose="0 -0.33 0  -0.5 -0.5 0.5 -0.5" solimp="0.5 0.9 0.01" solref="0.02 1"/>
  </equality>

  <actuator>
    <!-- Franka FR3 Actuators -->
    <position class="fr3" name="fr3_joint1" joint="fr3_joint1" kp="4500" kv="450"/>
    <position class="fr3" name="fr3_joint2" joint="fr3_joint2" kp="4500" kv="450"/>
    <position class="fr3" name="fr3_joint3" joint="fr3_joint3" kp="3500" kv="350"/>
    <position class="fr3" name="fr3_joint4" joint="fr3_joint4" kp="3500" kv="350"/>
    <position class="fr3" name="fr3_joint5" joint="fr3_joint5" kp="2000" kv="200"/>
    <position class="fr3" name="fr3_joint6" joint="fr3_joint6" kp="2000" kv="200"/>
    <position class="fr3" name="fr3_joint7" joint="fr3_joint7" kp="2000" kv="200"/>
    <general class="fr3" name="actuator8" tendon="split" forcerange="-100 100" ctrlrange="0 255"
      gainprm="0.01568627451 0 0" biasprm="0 -100 -10"/>

    <!-- HEAL Actuators (Converted to Position control for easy control via sliders) -->
    <position name="turret" joint="joint1" kp="5000" kv="500" />
    <position name="shoulder" joint="joint2" kp="5000" kv="500" />
    <position name="elbow" joint="joint3" kp="5000" kv="500" />
    <position name="wrist_1" joint="joint4" kp="1000" kv="100" />
    <position name="wrist_2" joint="joint5" kp="1000" kv="100" />
    <position name="wrist_3" joint="joint6" kp="1000" kv="100" />
    <position name="heal_gripper" joint="finger_joint" kp="100" kv="10" />
  </actuator>

  <contact>
    <exclude body1="fr3_link0" body2="fr3_link1"/>
    <!-- Exclude collisions between plate and gripper fingers/hand bodies to prevent force explosions with welds -->
    <exclude body1="plate" body2="hand"/>
    <exclude body1="plate" body2="left_finger"/>
    <exclude body1="plate" body2="right_finger"/>
    <exclude body1="plate" body2="end-effector"/>
    <exclude body1="plate" body2="left_inner_finger"/>
    <exclude body1="plate" body2="right_inner_finger"/>
    <exclude body1="plate" body2="left_outer_knuckle"/>
    <exclude body1="plate" body2="right_outer_knuckle"/>
    <exclude body1="plate" body2="left_inner_knuckle"/>
    <exclude body1="plate" body2="right_inner_knuckle"/>
  </contact>

  <keyframe>
    <!-- Keyframe 0: Plate-holding ready configuration -->
    <key name="hold_plate" qpos="-0.4091 -1.3020 0.1714 -2.9253 -1.4271 1.9426 0.8450 0.005 0.005 -0.1229 -0.4379 -0.6354 -1.7579 -0.2429 2.9555 0.65 0.78 -0.78 -0.78 0.78 -0.65  0.20 -0.40 0.55 1 0 0 0  0.20 -0.40 0.578 1 0 0 0"/>
  </keyframe>
  <sensor>
    <force name="franka_force" site="franka_ee_site"/>
    <force name="heal_force" site="heal_ee_site"/>
    <torque name="franka_torque" site="franka_ee_site"/>
    <torque name="heal_torque" site="heal_ee_site"/>
  </sensor>
</mujoco>
